<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.viewgene.infrastructure.persistence.mapper.TemplateCategoryMapper">
    <resultMap id="categoryResult" type="com.viewgene.domain.model.TemplateCategory">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="sort_order" javaType="java.lang.Integer"/>
            <arg column="enabled" javaType="java.lang.Boolean"/>
        </constructor>
    </resultMap>

    <select id="findAllEnabled" resultMap="categoryResult">
        SELECT id, code, name, sort_order, enabled
        FROM template_category
        WHERE enabled = 1
        ORDER BY sort_order, id
    </select>
</mapper>
