# Copy the relevant values into your local shell or local .env files.
# Do not commit real credentials.
DB_URL=jdbc:mysql://localhost:3306/view_gene?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=view_gene
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
UPLOAD_DIR=./uploads
SIMULATION_MATERIAL_CHECK_DELAY_MS=1000
SIMULATION_GENERATING_DELAY_MS=3000
SIMULATION_FINALIZING_DELAY_MS=1000
SIMULATION_FAILURE_STAGE=NONE
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
